{
  "name": "shun198-qiita",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "lint": "pnpm run lint:md && pnpm run lint:text",
    "lint:md": "markdownlint-cli2",
    "lint:text": "textlint \"README.md\" \"CONTRIBUTING.md\"",
    "lint:articles:text": "textlint \"public/**/*.md\"",
    "qiita:pull": "bash ./scripts/qiita-pull.sh"
  },
  "devDependencies": {
    "@qiita/qiita-cli": "^1.9.1",
    "markdownlint-cli2": "^0.23.1",
    "textlint": "^15.7.1",
    "textlint-rule-preset-ja-technical-writing": "^12.0.2"
  },
  "volta": {
    "node": "26.4.0"
  }
}
